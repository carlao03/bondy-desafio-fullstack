# URL do MongoDB de teste (ajuste se já existir outro no projeto)
MONGO_URI=mongodb://localhost:27017/bondy-test

# Secret para assinar os JWTs (troque por uma string forte)
JWT_SECRET=uma_chave_secreta_local_@1234

# Tempo de expiração do token
JWT_EXPIRES_IN=7d

# Porta do servidor (ajuste se necessário)
PORT=4000

# NODE_ENV não obrigatório, mas útil
NODE_ENV=development